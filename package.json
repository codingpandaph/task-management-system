{
  "name": "task-management-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:retain": "node scripts/dev.mjs",
    "dev:fresh": "FRESH_DB=true node scripts/dev.mjs",
    "dev:services": "yarn workspace @tms/contracts build && concurrently --kill-others --names web,api \"yarn dev:web\" \"yarn dev:api\"",
    "dev:web": "yarn workspace @tms/web dev",
    "dev:api": "yarn workspace @tms/api dev",
    "build": "yarn workspace @tms/contracts build && yarn workspace @tms/api build && yarn workspace @tms/web build",
    "start:web": "yarn workspace @tms/web start",
    "start:api": "yarn workspace @tms/api start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && yarn workspace @tms/api typecheck && yarn workspace @tms/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn test:unit && yarn test:tooling && yarn test:integration && yarn test:e2e",
    "test:unit": "yarn workspace @tms/api test",
    "test:tooling": "node --test tests/tooling/*.spec.mjs",
    "e2e:db:reset": "node tests/e2e/reset-database.mjs",
    "test:e2e": "yarn e2e:db:reset && playwright test",
    "demo:e2e": "yarn e2e:db:reset && PLAYWRIGHT_DEMO=1 playwright test tests/e2e/demo.spec.ts --headed",
    "test:e2e:ui": "yarn e2e:db:reset && playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "yarn workspace @tms/api seed",
    "test:integration": "yarn workspace @tms/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.62.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
